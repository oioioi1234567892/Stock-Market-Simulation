# ==========================================
# 台股智選量化操盤室 - 環境變數設定範例
# ==========================================

# 1. 應用程式 URL (Vercel 或正式站點網址)
APP_URL="https://your-app.vercel.app"

# 2. Gemini AI API Key (若啟用 AI 智慧分析功能時使用)
GEMINI_API_KEY=""

# 3. 資料庫連線 (可選，支援 Vercel Postgres / Neon / Supabase / Cloud SQL)
# 若未設定，系統會自動啟用高靈敏度的記憶體 + 前端 LocalStorage 備援模式
DATABASE_URL=""
POSTGRES_URL=""
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DATABASE=""

# 4. Firebase 設定 (若啟用多裝置雲端帳號同步時使用，前端已內建開箱即用設定)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
